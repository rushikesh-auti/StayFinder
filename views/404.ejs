<%- include('partials/head') %>

<body class="bg-background">
<%- include('partials/nav') %>
<main class="flex min-h-[calc(100vh-80px)] items-center justify-center px-4">
    <section
        class="w-full max-w-md rounded-3xl bg-white p-10 text-center shadow-card transition duration-300 hover:-translate-y-1 hover:shadow-xl">

        <h1 class="text-7xl font-extrabold tracking-tight text-primary">
            404
        </h1>

        <h2 class="mt-4 text-3xl font-bold text-text">
            Oops! Page Not Found
        </h2>

        <p class="mx-auto mt-4 max-w-sm leading-7 text-muted">
            The page you're looking for doesn't exist or may have been moved.
            Try returning to the homepage.
        </p>

        <div class="mt-8">
            <a
                href="/"
                class="inline-flex items-center justify-center rounded-xl bg-primary px-8 py-3 font-semibold text-white transition duration-300 hover:-translate-y-1 hover:bg-secondary hover:shadow-lg">
                Back to Home
            </a>
        </div>
    </section>

</main>
</body>

</html>