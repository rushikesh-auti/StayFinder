<%- include('../partials/head') %>
</head>
<body class="bg-background">
  <%- include('../partials/nav') %>

  <main class="mx-auto max-w-6xl px-4 py-10 lg:px-6 lg:py-14">
    <section class="mb-8 rounded-3xl bg-white p-8 shadow-card">
      <div class="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
        <div>
          <h1 class="text-4xl font-bold text-text">My Profile</h1>
          <p class="mt-2 text-muted">
            Manage your StayFinder account details and view your preferences.
          </p>
        </div>
        <div class="rounded-3xl bg-surface p-5 text-sm text-muted">
          <p class="font-semibold text-text">User Type</p>
          <p class="mt-1"><%= profileUser.userType %></p>
        </div>
      </div>
    </section>

    <section class="grid gap-8 lg:grid-cols-[1.2fr_0.8fr]">
      <div class="space-y-6 rounded-3xl bg-white p-8 shadow-card">
        <div class="rounded-3xl border border-border p-6">
          <h2 class="text-2xl font-semibold text-text">Personal Information</h2>
          <div class="mt-6 grid gap-4 sm:grid-cols-2">
            <div>
              <p class="text-sm font-medium uppercase tracking-wide text-muted">First Name</p>
              <p class="mt-2 text-lg font-semibold text-text"><%= profileUser.firstName %></p>
            </div>
            <div>
              <p class="text-sm font-medium uppercase tracking-wide text-muted">Last Name</p>
              <p class="mt-2 text-lg font-semibold text-text"><%= profileUser.lastName || '—' %></p>
            </div>
            <div class="sm:col-span-2">
              <p class="text-sm font-medium uppercase tracking-wide text-muted">Email</p>
              <p class="mt-2 text-lg font-semibold text-text"><%= profileUser.email %></p>
            </div>
          </div>
        </div>

        <div class="rounded-3xl border border-border p-6">
          <h2 class="text-2xl font-semibold text-text">Account Details</h2>
          <div class="mt-6 grid gap-4 sm:grid-cols-2">
            <div>
              <p class="text-sm font-medium uppercase tracking-wide text-muted">Member Since</p>
              <p class="mt-2 text-lg font-semibold text-text"><%= new Date(profileUser.createdAt).toLocaleDateString() %></p>
            </div>
            <div>
              <p class="text-sm font-medium uppercase tracking-wide text-muted">Favourites</p>
              <p class="mt-2 text-lg font-semibold text-text"><%= favouritesCount %> saved</p>
            </div>
            <div class="sm:col-span-2">
              <p class="text-sm font-medium uppercase tracking-wide text-muted">Last Updated</p>
              <p class="mt-2 text-lg font-semibold text-text"><%= new Date(profileUser.updatedAt).toLocaleDateString() %></p>
            </div>
          </div>
        </div>
      </div>

      <aside class="space-y-6 rounded-3xl bg-white p-8 shadow-card">
        <div class="rounded-3xl border border-border p-6">
          <h2 class="text-2xl font-semibold text-text">Quick Actions</h2>
          <div class="mt-6 flex flex-col gap-3">
            <a href="/homes" class="rounded-2xl border border-border bg-surface px-4 py-3 text-sm font-semibold text-text transition hover:bg-primary/5">Browse Homes</a>
            <a href="/favourites" class="rounded-2xl border border-border bg-surface px-4 py-3 text-sm font-semibold text-text transition hover:bg-primary/5">View Favourites</a>
            <a href="/bookings" class="rounded-2xl border border-border bg-surface px-4 py-3 text-sm font-semibold text-text transition hover:bg-primary/5">My Bookings</a>
          </div>
        </div>

        <div class="rounded-3xl border border-border p-6">
          <h2 class="text-2xl font-semibold text-text">Security</h2>
          <p class="mt-4 text-sm text-muted">
            Your password and login settings are managed securely. To change your password, use the account settings from your login provider.
          </p>
        </div>
      </aside>
    </section>
  </main>

  <%- include('../partials/footer') %>
</body>
</html>
