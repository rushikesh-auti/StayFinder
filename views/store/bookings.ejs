<%- include('../partials/head') %>

<body class="bg-background">
<%- include('../partials/nav') %>
<main class="mx-auto max-w-7xl px-4 py-14">
    <section class="mb-12 text-center">
        <h1 class="text-4xl font-bold text-text">
            My Bookings
        </h1>
        <p class="mt-3 text-lg text-muted">
            View and manage all your upcoming and previous bookings.
        </p>
    </section>

    <% if(bookings.length === 0){ %>
        <section class="mt-10 flex justify-center">
            <div class="w-full max-w-sm rounded-2xl bg-white p-8 text-center shadow-card">
                <h2 class="text-2xl font-bold text-text">
                    No Bookings Yet
                </h2>
                <p class="mt-4 mb-8 leading-7 text-muted">
                    You haven't booked any stays yet.
                </p>
                <a
                    href="/homes"
                    class="inline-flex items-center justify-center rounded-xl bg-primary px-6 py-3 font-semibold text-white transition hover:bg-secondary">
                    Explore Homes
                </a>
            </div>
        </section>

  <% } else { %>

<section class="grid gap-8 lg:grid-cols-2">

    <% bookings.forEach(booking => { %>

    <article class="flex flex-col md:flex-row gap-6 rounded-3xl bg-surface p-5 shadow-card">

    <img
        src="<%= booking.home.photo %>"
        class="h-40 w-full rounded-2xl object-cover md:w-52">

    <div class="flex flex-1 flex-col justify-between">

        <div>

            <div class="flex items-start justify-between">

                <div>

                    <h2 class="text-2xl font-bold text-text">
                        <%= booking.home.houseName %>
                    </h2>

                    <p class="mt-1 text-muted">
                        📍 <%= booking.home.location %>
                    </p>

                </div>

                <span
                    class="rounded-full bg-green-100 px-3 py-1 text-sm font-semibold text-green-600">

                    <%= booking.bookingStatus %>

                </span>

            </div>

            <div class="mt-6 grid grid-cols-2 gap-4">

                <div>
                    <p class="text-xs text-muted">Check-in</p>
                    <p class="font-semibold">
                        <%= new Date(booking.checkIn).toLocaleDateString() %>
                    </p>
                </div>

                <div>
                    <p class="text-xs text-muted">Check-out</p>
                    <p class="font-semibold">
                        <%= new Date(booking.checkOut).toLocaleDateString() %>
                    </p>
                </div>

                <div>
                    <p class="text-xs text-muted">Guests</p>
                    <p class="font-semibold">
                        <%= booking.guests %>
                    </p>
                </div>

                <div>
                    <p class="text-xs text-muted">Total Price</p>
                    <p class="font-bold text-primary">
                        ₹<%= booking.totalPrice %>
                    </p>
                </div>

            </div>

        </div>

        <div class="mt-6 flex gap-3">

            <a
                href="/homes/<%= booking.home._id %>"
                class="flex-1 rounded-xl border border-primary py-3 text-center font-semibold text-primary transition hover:bg-primary hover:text-white">

                View Property

            </a>

            <% if(booking.bookingStatus !== 'Cancelled'){ %>

            <form
                action="/bookings/cancel/<%= booking._id %>"
                method="POST"
                class="flex-1">

                <button
                    class="w-full rounded-xl bg-red-500 py-3 font-semibold text-white transition hover:bg-red-600">

                    Cancel

                </button>

            </form>

            <% } %>

        </div>

    </div>

</article>

    <% }) %>

</section>

<% } %>
</main>
</body>

</html>