<%- include('../partials/head') %>

<body class="bg-background">
  <%- include('../partials/nav') %>

  <main class="mx-auto max-w-7xl flex-1 px-4 py-10 lg:px-6 lg:py-14">
    <section class="mb-10 text-center">
      <h1 class="text-3xl font-bold text-text md:text-4xl">
        My Bookings
      </h1>

  <p class="mt-3 text-sm text-muted md:text-base">
    View and manage all your upcoming and previous bookings.
  </p>
</section>

<% if (bookings.length === 0) { %>
  <section class="flex justify-center">
    <div class="w-full max-w-md rounded-2xl bg-white p-8 text-center shadow-card">
      <h2 class="text-2xl font-bold text-text">No Bookings Yet</h2>

      <p class="mb-8 mt-4 leading-7 text-muted">
        You haven't booked any stays yet. Start exploring amazing places.
      </p>

      <a
        href="/homes"
        class="inline-flex rounded-xl bg-primary px-6 py-3 font-semibold text-white transition hover:bg-secondary">
        Explore Homes
      </a>
    </div>
  </section>
<% } else { %>

  <section class="grid gap-6">
    <% bookings.forEach((booking) => { %>
      <article class="overflow-hidden rounded-3xl border border-border bg-surface shadow-card transition-all duration-300 hover:-translate-y-1 hover:shadow-xl">

        <div class="flex flex-col lg:flex-row">
          <img
            src="<%= booking.home.photo %>"
            alt="<%= booking.home.houseName %>"
            class="h-60 w-full object-cover lg:h-auto lg:w-80"/>

          <div class="flex flex-1 flex-col justify-between p-6 lg:p-8">

            <div>
              <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">

                <div>
                  <h2 class="text-2xl font-bold text-text lg:text-3xl">
                    <%= booking.home.houseName %>
                  </h2>

                  <p class="mt-2 flex items-center gap-2 text-sm text-muted">
                    <span>📍</span>
                    <span><%= booking.home.location %></span>
                  </p>
                </div>

                <span
                  class="inline-flex items-center rounded-full px-4 py-2 text-sm font-semibold
                  <%= booking.bookingStatus === 'Confirmed'
                    ? 'bg-green-100 text-green-700'
                    : booking.bookingStatus === 'Cancelled'
                      ? 'bg-red-100 text-red-700'
                      : 'bg-yellow-100 text-yellow-700' %>">
                  <%= booking.bookingStatus %>
                </span>
              </div>

              <div class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-3">

                <div class="rounded-2xl bg-background p-4 ring-1 ring-border/50">
                  <p class="text-xs font-medium uppercase tracking-wide text-muted">
                    Check-In
                  </p>
                  <p class="mt-2 text-sm font-semibold text-text">
                    <%= new Date(booking.checkIn).toLocaleDateString() %>
                  </p>
                </div>

                <div class="rounded-2xl bg-background p-4 ring-1 ring-border/50">
                  <p class="text-xs font-medium uppercase tracking-wide text-muted">
                    Check-Out
                  </p>
                  <p class="mt-2 text-sm font-semibold text-text">
                    <%= new Date(booking.checkOut).toLocaleDateString() %>
                  </p>
                </div>

                <div class="rounded-2xl bg-background p-4 ring-1 ring-border/50">
                  <p class="text-xs font-medium uppercase tracking-wide text-muted">
                    Nights
                  </p>
                  <p class="mt-2 text-sm font-semibold text-text">
                    <%= booking.nights %>
                  </p>
                </div>

                <div class="rounded-2xl bg-background p-4 ring-1 ring-border/50">
                  <p class="text-xs font-medium uppercase tracking-wide text-muted">
                    Guests
                  </p>
                  <p class="mt-2 text-sm font-semibold text-text">
                    <%= booking.guests %>
                  </p>
                </div>

                <div class="col-span-2 rounded-2xl bg-blue-50 p-4 ring-1 ring-blue-100 sm:col-span-1">
                  <p class="text-xs font-medium uppercase tracking-wide text-blue-700">
                    Total Paid
                  </p>
                  <p class="mt-2 text-xl font-bold text-primary">
                    ₹<%= booking.totalPrice %>
                  </p>
                </div>
              </div>
            </div>

            <div class="mt-8 grid grid-cols-1 gap-3 sm:grid-cols-2">

              <a
                href="/homes/<%= booking.home._id %>"
                class="flex h-12 items-center justify-center rounded-xl border border-primary bg-white px-5 text-sm font-semibold text-primary transition-all duration-300 hover:bg-primary hover:text-white hover:shadow-md">
                View Property
              </a>

              <% if (booking.bookingStatus !== 'Cancelled') { %>

                <% if (booking.canCancel) { %>
                  <button
                    type="button"
                    onclick="openCancelModal('<%= booking._id %>')"
                    class="flex h-12 items-center justify-center rounded-xl bg-red-500 px-5 text-sm font-semibold text-white transition-all duration-300 hover:bg-red-600 hover:shadow-md">
                    Cancel Booking
                  </button>
                <% } else { %>
                  <button
                    type="button"
                    disabled
                    class="flex h-12 items-center justify-center rounded-xl bg-gray-200 px-5 text-sm font-semibold text-gray-500 cursor-not-allowed">
                    Cancellation Closed
                  </button>
                <% } %>

              <% } else { %>

                <button
                  disabled
                  class="flex h-12 items-center justify-center rounded-xl bg-gray-200 px-5 text-sm font-semibold text-gray-500 cursor-not-allowed">
                  Booking Cancelled
                </button>

              <% } %>
            </div>
          </div>
        </div>
      </article>
    <% }) %>
  </section>

<% } %>
  </main>

  <div
    id="cancelModal"
    class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 px-4">
<div class="w-full max-w-md rounded-2xl bg-white p-6 shadow-xl">\
  <div class="text-center">
    <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-red-100">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </div>

    <h2 class="text-xl font-bold text-text">
      Cancel Booking?
    </h2>

    <p class="mt-3 text-sm leading-6 text-muted">
      Are you sure you want to cancel this booking? This action cannot be undone.
    </p>
  </div>

  <div class="mt-6 flex gap-3">
    <button
      type="button"
      onclick="closeCancelModal()"
      class="flex-1 rounded-xl border border-border px-4 py-3 font-semibold text-text transition hover:bg-gray-50">
      Keep Booking
    </button>

    <form id="cancelBookingForm" method="POST" class="flex-1">
      <button
        type="submit"
        class="w-full rounded-xl bg-red-500 px-4 py-3 font-semibold text-white transition hover:bg-red-600">
        Yes, Cancel
      </button>
    </form>
  </div>
</div>
  </div>

  <script>
    function openCancelModal(bookingId) {
      const modal = document.getElementById("cancelModal");
      const form = document.getElementById("cancelBookingForm");

      form.action = `/bookings/cancel/${bookingId}`;
      modal.classList.remove("hidden");
      modal.classList.add("flex");
      document.body.classList.add("overflow-hidden");
    }

    function closeCancelModal() {
      const modal = document.getElementById("cancelModal");

      modal.classList.add("hidden");
      modal.classList.remove("flex");
      document.body.classList.remove("overflow-hidden");
    }

    document.getElementById("cancelModal").addEventListener("click", function (e) {
      if (e.target === this) {
        closeCancelModal();
      }
    });
  </script>

<%- include('../partials/footer') %>

</body>

</html>
