<%- include("../partials/head") %>

<body class="bg-background">

<%- include("../partials/nav") %>

<main class="mx-auto max-w-6xl px-4 py-10 lg:px-6">
    <div class="group relative overflow-hidden rounded-3xl shadow-card">

        <img
            src="<%= home.photo %>"
            alt="<%= home.houseName %>"
            class="h-[320px] w-full object-cover object-center transition-transform duration-700 ease-out group-hover:scale-105 sm:h-[420px] lg:h-[480px]">

        <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/60 via-black/0 to-black/0"></div>

        <div class="absolute top-5 right-5">
            <%- include("../partials/favourite") %>
        </div>

        <div class="absolute bottom-0 left-0 right-0 p-6 sm:p-8">
            <h1 class="text-3xl font-bold text-white drop-shadow-sm sm:text-4xl lg:text-5xl">
                <%= home.houseName %>
            </h1>
            <div class="mt-3 flex flex-wrap items-center gap-3">
                <div class="flex items-center gap-1.5 rounded-full bg-white/90 backdrop-blur px-3.5 py-1.5 shadow-sm">
                    <span class="text-amber-500">★</span>
                    <span class="text-sm font-semibold text-text"><%= home.rating %></span>
                </div>
                <div class="flex items-center gap-1.5 rounded-full bg-white/90 backdrop-blur px-3.5 py-1.5 shadow-sm">
                    <span class="text-sm font-semibold text-text"><%= home.location %></span>
                </div>
            </div>
        </div>

    </div>

    <div class="mt-10 grid gap-8 lg:grid-cols-3 lg:gap-10">
        <div class="space-y-6 lg:col-span-2">

            <section class="rounded-2xl bg-surface p-7 shadow-card ring-1 ring-border/50 sm:p-8">
                <h2 class="mb-4 flex items-center gap-2 text-xl font-bold text-text sm:text-2xl">
                    <span class="inline-block h-6 w-1.5 rounded-full bg-primary"></span>
                    About this Property
                </h2>
                <p class="text-[15px] leading-8 text-muted">
                    <%= home.description %>
                </p>
            </section>

            <section class="rounded-2xl bg-surface p-7 shadow-card ring-1 ring-border/50 sm:p-8">
                <h2 class="mb-6 flex items-center gap-2 text-xl font-bold text-text sm:text-2xl">
                    <span class="inline-block h-6 w-1.5 rounded-full bg-primary"></span>
                    Property Highlights
                </h2>

                <div class="grid grid-cols-2 gap-4 md:grid-cols-3">

                    <div class="group flex flex-col items-center gap-2 rounded-xl border border-border p-5 text-center transition-all duration-300 hover:-translate-y-1 hover:border-primary/40 hover:bg-primary/5 hover:shadow-md">
                        <span class="text-2xl transition-transform duration-300 group-hover:scale-110">🏠</span>
                        <p class="text-sm font-semibold text-text">Entire Home</p>
                    </div>

                    <div class="group flex flex-col items-center gap-2 rounded-xl border border-border p-5 text-center transition-all duration-300 hover:-translate-y-1 hover:border-primary/40 hover:bg-primary/5 hover:shadow-md">
                        <span class="text-2xl transition-transform duration-300 group-hover:scale-110">📶</span>
                        <p class="text-sm font-semibold text-text">Free WiFi</p>
                    </div>

                    <div class="group flex flex-col items-center gap-2 rounded-xl border border-border p-5 text-center transition-all duration-300 hover:-translate-y-1 hover:border-primary/40 hover:bg-primary/5 hover:shadow-md">
                        <span class="text-2xl transition-transform duration-300 group-hover:scale-110">🚗</span>
                        <p class="text-sm font-semibold text-text">Parking</p>
                    </div>

                    <div class="group flex flex-col items-center gap-2 rounded-xl border border-border p-5 text-center transition-all duration-300 hover:-translate-y-1 hover:border-primary/40 hover:bg-primary/5 hover:shadow-md">
                        <span class="text-2xl transition-transform duration-300 group-hover:scale-110">🍽️</span>
                        <p class="text-sm font-semibold text-text">Kitchen</p>
                    </div>

                    <div class="group flex flex-col items-center gap-2 rounded-xl border border-border p-5 text-center transition-all duration-300 hover:-translate-y-1 hover:border-primary/40 hover:bg-primary/5 hover:shadow-md">
                        <span class="text-2xl transition-transform duration-300 group-hover:scale-110">📺</span>
                        <p class="text-sm font-semibold text-text">Smart TV</p>
                    </div>

                    <div class="group flex flex-col items-center gap-2 rounded-xl border border-border p-5 text-center transition-all duration-300 hover:-translate-y-1 hover:border-primary/40 hover:bg-primary/5 hover:shadow-md">
                        <span class="text-2xl transition-transform duration-300 group-hover:scale-110">🧹</span>
                        <p class="text-sm font-semibold text-text">Clean Rooms</p>
                    </div>

                </div>
            </section>

        </div>

        <aside>
            <div class="sticky top-28 rounded-3xl bg-surface p-8 shadow-card ring-1 ring-border/50">

                <div class="flex items-baseline gap-1">
                    <p class="text-4xl font-bold text-primary">₹<%= home.price %></p>
                    <span class="text-muted">/ night</span>
                </div>

                <button
                    class="mt-6 w-full rounded-xl bg-primary py-4 text-lg font-semibold text-white shadow-sm transition-all duration-300 hover:bg-secondary hover:shadow-lg active:scale-[0.98]">
                    Reserve Now
                </button>

                <p class="mt-3 text-center text-xs text-muted">You won't be charged yet</p>

                <div class="mt-7 space-y-4 border-t border-border pt-6">

                    <div class="flex items-center justify-between">
                        <span class="text-sm text-muted">Rating</span>
                        <span class="flex items-center gap-1 font-semibold text-text">
                            <span class="text-amber-500">★</span> <%= home.rating %>
                        </span>
                    </div>

                    <div class="flex items-center justify-between">
                        <span class="text-sm text-muted">Location</span>
                        <span class="font-semibold text-text"><%= home.location %></span>
                    </div>

                </div>
            </div>
        </aside>
    </div>

</main>
</body>

</html>
