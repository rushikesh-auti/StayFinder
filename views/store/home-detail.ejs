<%- include("../partials/head") %>

<body class="bg-background">
  <%- include("../partials/nav") %>

  <main class="mx-auto max-w-6xl px-4 py-10 lg:px-6">
    <div class="group relative overflow-hidden rounded-3xl shadow-card">
      <img
        src="<%= home.photo %>"
        alt="<%= home.houseName %>"
        class="h-[320px] w-full object-cover object-center transition-transform duration-700 ease-out group-hover:scale-105 sm:h-[420px] lg:h-[480px]"
      />

      <div
        class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/60 via-black/0 to-black/0"
      ></div>

      <div class="absolute right-5 top-5">
        <% if (!user || (user && home.host.toString() !== user._id.toString())) { %>
          <%- include("../partials/favourite") %>
        <% } %>
      </div>

      <div class="absolute bottom-0 left-0 right-0 p-6 sm:p-8">
        <h1
          class="text-3xl font-bold text-white drop-shadow-sm sm:text-4xl lg:text-5xl">
          <%= home.houseName %>
        </h1>

        <div class="mt-3 flex flex-wrap items-center gap-3">
          <div
            class="flex items-center gap-1.5 rounded-full bg-white/90 px-3.5 py-1.5 shadow-sm backdrop-blur"
          >
            <span class="text-amber-500">★</span>
            <span class="text-sm font-semibold text-text">
              <%= home.rating %>
            </span>
          </div>

          <div
            class="flex items-center gap-1.5 rounded-full bg-white/90 px-3.5 py-1.5 shadow-sm backdrop-blur"
          >
            <span class="text-sm font-semibold text-text">
              <%= home.location %>
            </span>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-10 grid gap-8 lg:grid-cols-3 lg:gap-10">
      <div class="space-y-6 lg:col-span-2">
        <section
          class="rounded-2xl bg-surface p-7 shadow-card ring-1 ring-border/50 sm:p-8"
        >
          <h2
            class="mb-4 flex items-center gap-2 text-xl font-bold text-text sm:text-2xl"
          >
            <span class="inline-block h-6 w-1.5 rounded-full bg-primary"></span>
            About this Property
          </h2>

          <p class="text-[15px] leading-8 text-muted">
            <%= home.description %>
          </p>
        </section>

        <section
          class="rounded-2xl bg-surface p-7 shadow-card ring-1 ring-border/50 sm:p-8"
        >
          <h2
            class="mb-6 flex items-center gap-2 text-xl font-bold text-text sm:text-2xl">
            <span class="inline-block h-6 w-1.5 rounded-full bg-primary"></span>
            Property Highlights
          </h2>

          <div class="grid grid-cols-2 gap-4 md:grid-cols-3">
            <div
              class="group flex flex-col items-center gap-2 rounded-xl border border-border p-5 text-center transition-all duration-300 hover:-translate-y-1 hover:border-primary/40 hover:bg-primary/5 hover:shadow-md"
            >
              <span
                class="text-2xl transition-transform duration-300 group-hover:scale-110">🏠</span>
              <p class="text-sm font-semibold text-text">Entire Home</p>
            </div>

            <div
              class="group flex flex-col items-center gap-2 rounded-xl border border-border p-5 text-center transition-all duration-300 hover:-translate-y-1 hover:border-primary/40 hover:bg-primary/5 hover:shadow-md"
            >
              <span
                class="text-2xl transition-transform duration-300 group-hover:scale-110">📶</span>
              <p class="text-sm font-semibold text-text">Free WiFi</p>
            </div>

            <div
              class="group flex flex-col items-center gap-2 rounded-xl border border-border p-5 text-center transition-all duration-300 hover:-translate-y-1 hover:border-primary/40 hover:bg-primary/5 hover:shadow-md">
              <span
                class="text-2xl transition-transform duration-300 group-hover:scale-110">🚗</span>
              <p class="text-sm font-semibold text-text">Parking</p>
            </div>

            <div
              class="group flex flex-col items-center gap-2 rounded-xl border border-border p-5 text-center transition-all duration-300 hover:-translate-y-1 hover:border-primary/40 hover:bg-primary/5 hover:shadow-md">
              <span
                class="text-2xl transition-transform duration-300 group-hover:scale-110">🍽️</span>
              <p class="text-sm font-semibold text-text">Kitchen</p>
            </div>

            <div
              class="group flex flex-col items-center gap-2 rounded-xl border border-border p-5 text-center transition-all duration-300 hover:-translate-y-1 hover:border-primary/40 hover:bg-primary/5 hover:shadow-md">
              <span
                class="text-2xl transition-transform duration-300 group-hover:scale-110">📺</span>
              <p class="text-sm font-semibold text-text">Smart TV</p>
            </div>

            <div
              class="group flex flex-col items-center gap-2 rounded-xl border border-border p-5 text-center transition-all duration-300 hover:-translate-y-1 hover:border-primary/40 hover:bg-primary/5 hover:shadow-md">
              <span
                class="text-2xl transition-transform duration-300 group-hover:scale-110">🧹</span>
              <p class="text-sm font-semibold text-text">Clean Rooms</p>
            </div>
          </div>
        </section>
      </div>

      <aside>
        <div
          class="sticky top-28 rounded-3xl bg-surface p-8 shadow-card ring-1 ring-border/50">
          <%
          const initialBookingError =
            typeof bookingError !== "undefined" ? bookingError : "";
          %>

          <div
            id="booking-error"
            class="mb-5 rounded-xl bg-red-100 p-4 text-red-600"
            <% if (!initialBookingError) { %>
            style="display: none;"
            <% } %>
          >
            <%= initialBookingError %>
          </div>

          <% if (!user) { %>

          <a
            href="/login"
            class="block w-full rounded-xl bg-primary py-4 text-center text-lg font-semibold text-white transition duration-300 hover:bg-secondary"
          >
            Login to Book
          </a>

          <% } else if (home.host.toString() === user._id.toString()) { %>

          <div class="rounded-xl bg-yellow-100 p-4 text-center font-semibold text-yellow-800">
            You cannot book your own property.
          </div>

          <% } else { %>

          <form
            id="bookingForm"
            class="mt-6 space-y-5"
          >
            <div>
              <label class="mb-2 block text-sm font-medium text-text">
                Check-in
              </label>

              <input
                id="checkIn"
                type="date"
                name="checkIn"
                required
                class="w-full rounded-xl border border-border bg-background px-4 py-3 focus:border-primary focus:outline-none"
              />
            </div>

            <div>
              <label class="mb-2 block text-sm font-medium text-text">
                Check-out
              </label>

              <input
                id="checkOut"
                type="date"
                name="checkOut"
                required
                class="w-full rounded-xl border border-border bg-background px-4 py-3 focus:border-primary focus:outline-none"
              />
            </div>

            <div>
              <label class="mb-2 block text-sm font-medium text-text">
                Guests
              </label>

              <input
                id="guests"
                type="number"
                name="guests"
                value="1"
                min="1"
                max="10"
                required
                class="w-full rounded-xl border border-border bg-background px-4 py-3 focus:border-primary focus:outline-none"
              />
            </div>

            <button
              id="reserve-button"
              type="submit"
              class="w-full rounded-xl bg-primary py-4 text-lg font-semibold text-white transition duration-300 hover:bg-secondary disabled:cursor-not-allowed disabled:bg-gray-400"
            >
              Reserve Now
            </button>
          </form>

          <% } %>

          <p class="mt-4 text-center text-xs text-muted">
            Your booking will be confirmed instantly.
          </p>

          <div class="mt-7 space-y-4 border-t border-border pt-6">
            <div class="flex items-center justify-between">
              <span class="text-sm text-muted">Rating</span>

              <span class="flex items-center gap-1 font-semibold text-text">
                <span class="text-amber-500">★</span>
                <%= home.rating %>
              </span>
            </div>

            <div class="flex items-center justify-between">
              <span class="text-sm text-muted">Location</span>

              <span class="font-semibold text-text">
                <%= home.location %>
              </span>
            </div>
          </div>
        </div>
      </aside>
    </div>
  </main>
<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<script>
  const checkInInput = document.querySelector('input[name="checkIn"]');
  const checkOutInput = document.querySelector('input[name="checkOut"]');
  const submitButton = document.getElementById('reserve-button');
  const errorBox = document.getElementById('booking-error');
  const homeId = '<%= home._id %>';

  const setAvailabilityState = (isAvailable, message = '') => {
    if (!submitButton) return;

    submitButton.disabled = !isAvailable;
    submitButton.textContent = isAvailable ? 'Reserve Now' : 'Unavailable';

    if (errorBox) {
      errorBox.textContent = message;
      errorBox.style.display = message ? 'block' : 'none';
    }
  };

  const checkAvailability = async () => {
    const checkIn = checkInInput?.value;
    const checkOut = checkOutInput?.value;

    if (!checkIn || !checkOut) {
      setAvailabilityState(true, '');
      return;
    }

    if (checkIn >= checkOut) {
      setAvailabilityState(false, 'Please select valid dates.');
      return;
    }

    try {
      const response = await fetch(`/bookings/check-availability/${homeId}?checkIn=${encodeURIComponent(checkIn)}&checkOut=${encodeURIComponent(checkOut)}`);
      const data = await response.json();
      setAvailabilityState(data.available, data.message || '');
    } catch (err) {
      setAvailabilityState(false, 'Unable to check availability right now.');
    }
  };

  [checkInInput, checkOutInput].forEach((input) => {
    input?.addEventListener('change', checkAvailability);
    input?.addEventListener('input', checkAvailability);
  });

  const initialError = '<%= initialBookingError %>';
  if (initialError) {
    setAvailabilityState(false, initialError);
  } else {
    checkAvailability();
  }

const bookingForm = document.getElementById("bookingForm");

if (bookingForm) {
  bookingForm.addEventListener("submit", async (e) => {
    e.preventDefault();

    if (submitButton.disabled) {
      return;
    }

    const checkIn = document.getElementById("checkIn").value;
    const checkOut = document.getElementById("checkOut").value;
    const guests = document.getElementById("guests").value;

    try {
      const response = await fetch("/payment/create-order", {
        method: "POST",
        credentials: "include",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          homeId,
          checkIn,
          checkOut,
          guests,
        }),
      });

      const data = await response.json();

      if (!data.success) {
        alert(data.message);
        return;
      }

      const options = {
        key: data.razorpayKey,
        amount: data.order.amount,
        currency: data.order.currency,
        name: "StayFinder",
        description: "<%= home.houseName %>",
        order_id: data.order.id,

        handler: async function (response) {
          try {
            const verify = await fetch("/payment/verify-payment", {
              method: "POST",
              credentials: "include",
              headers: {
                "Content-Type": "application/json",
              },
              body: JSON.stringify({
                razorpay_order_id: response.razorpay_order_id,
                razorpay_payment_id: response.razorpay_payment_id,
                razorpay_signature: response.razorpay_signature,
                homeId,
                checkIn,
                checkOut,
                guests,
                totalPrice: data.totalPrice,
              }),
            });

            if (!verify.ok) {
              const errorText = await verify.text();
              throw new Error(errorText || "Payment verification failed.");
            }

            window.location.assign("/bookings");
          } catch (err) {
            console.error(err);
            alert(
              err.message ||
                "We could not complete your booking. Please contact support if your payment was charged."
            );
          }
        },

        theme: {
          color: "#2563eb",
        },
      };

      const rzp = new Razorpay(options);

      rzp.open();
    } catch (err) {
      console.log(err);
      alert("Payment initialization failed.");
    }
  });
}
</script>
<%- include("../partials/footer") %>
</body>

</html>
