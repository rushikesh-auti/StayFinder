<%- include("../partials/head") %>

<body class="bg-background">
<%- include("../partials/nav") %>
<main class="flex-1">
    <section class="relative overflow-hidden">
        <div class="absolute inset-0 bg-gradient-to-r from-primary via-secondary to-accent opacity-95"></div>

        <div class="pointer-events-none absolute -top-24 -right-24 h-96 w-96 rounded-full bg-white/10 blur-3xl"></div>
        <div class="pointer-events-none absolute -bottom-32 left-1/3 h-80 w-80 rounded-full bg-white/10 blur-3xl"></div>

        <div class="relative mx-auto max-w-7xl px-6 py-24 lg:py-28">
            <div class="max-w-2xl text-white">
                <span class="inline-flex items-center gap-2 rounded-full bg-white/20 px-4 py-2 text-sm font-semibold backdrop-blur">
                    🏡 Trusted by Thousands of Travelers
                </span>

                <h1 class="mt-8 text-5xl font-extrabold leading-tight lg:text-6xl">
                    Find Your <span class="underline decoration-white/40 decoration-8 underline-offset-4">Perfect</span> Stay
                </h1>

                <p class="mt-6 text-xl leading-9 text-slate-100">
                    Explore beautiful homes, premium villas and unforgettable
                    experiences across India. Book your next stay in minutes.
                </p>

                <div class="mt-10 flex flex-wrap gap-4">
                    <a href="<%= isLoggedIn ? '/homes' : '/login' %>"
                        class="rounded-xl bg-white px-8 py-4 font-semibold text-primary transition-all duration-300 hover:-translate-y-1 hover:shadow-2xl">
                        Explore Homes
                    </a>
                    <% if (!isLoggedIn) { %>
                    <a href="/signup"
                        class="rounded-xl border border-white px-8 py-4 font-semibold text-white transition-all duration-300 hover:bg-white hover:text-primary">
                        Join StayFinder
                    </a>
                    <%}%>
                </div>
        <div class="pointer-events-none absolute bottom-0 left-0 right-0 h-16 bg-gradient-to-b from-transparent to-background/0"></div>
    </section>

    <section class="mx-auto mt-20 max-w-7xl px-6">
        <div class="mb-12 flex flex-col items-center text-center">
            <h2 class="text-4xl font-bold text-text">
                ⭐ Featured Homes
            </h2>
            <p class="mt-3 text-lg text-muted">
                Discover our most loved properties.
            </p>
        </div>

        <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
            <% registeredHomes.forEach(home => { %>

                <div class="group overflow-hidden rounded-3xl bg-surface shadow-card ring-1 ring-border/50 transition-all duration-300 hover:-translate-y-2 hover:shadow-2xl">
                    <div class="relative overflow-hidden">
                        <img
                            src="<%= home.photo %>"
                            alt="<%= home.houseName %>"
                            class="h-64 w-full object-cover transition duration-500 group-hover:scale-110">

                        <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/30 via-transparent to-transparent"></div>

                        <div class="absolute right-4 top-4">
                            <%- include('../partials/favourite',{home:home}) %>
                        </div>
                    </div>

                    <div class="p-6">
                        <h3 class="truncate text-2xl font-bold text-text">
                            <%= home.houseName %>
                        </h3>

                        <div class="mt-3 flex items-center gap-2 text-muted">
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="h-5 w-5 shrink-0 text-primary"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor">

                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M17.657 16.657L13.414 20.9a2 2 0 01-2.828 0L6.343 16.657a8 8 0 1111.314 0z"/>
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                            </svg>

                            <span class="truncate">
                                <%= home.location %>
                            </span>
                        </div>

                        <div class="mt-6 flex items-center justify-between">
                            <div>
                                <p class="text-3xl font-bold text-primary">
                                    ₹<%= home.price %>
                                </p>

                                <p class="text-sm text-muted">
                                    per night
                                </p>
                            </div>

                            <div class="flex items-center gap-1 rounded-full bg-yellow-100 px-4 py-2 font-semibold text-yellow-700">
                                ⭐ <%= home.rating %>
                            </div>

                        </div>
                        <a
                            href="<%= isLoggedIn ? '/homes/' + home._id : '/login' %>"
                            class="mt-6 block rounded-xl bg-primary py-3 text-center font-semibold text-white transition-all duration-300 hover:bg-secondary hover:shadow-lg active:scale-[0.98]">
                            View Details
                        </a>
                    </div>
                </div>
            <% }) %>
        </div>
    </section>

    <section class="mx-auto mt-28 max-w-7xl px-6">
        <div class="mb-12 flex flex-col items-center text-center">
            <h2 class="text-4xl font-bold text-text">
                Why Choose StayFinder?
            </h2>

            <p class="mt-3 text-lg text-muted">
                Everything you need for a comfortable stay.
            </p>
        </div>

        <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-4">
            <div class="group rounded-3xl bg-surface p-8 text-center shadow-card ring-1 ring-border/50 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl">
                <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl bg-primary/10 text-4xl transition-transform duration-300 group-hover:scale-110">
                    🏡
                </div>
                <h3 class="mt-5 text-xl font-bold text-text">
                    Premium Homes
                </h3>

                <p class="mt-3 text-muted">
                    Carefully verified properties with top-class amenities.
                </p>
            </div>

            <div class="group rounded-3xl bg-surface p-8 text-center shadow-card ring-1 ring-border/50 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl">
                <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl bg-primary/10 text-4xl transition-transform duration-300 group-hover:scale-110">
                    💰
                </div>
                <h3 class="mt-5 text-xl font-bold text-text">
                    Affordable Prices
                </h3>

                <p class="mt-3 text-muted">
                    Get the best value with transparent pricing.
                </p>
            </div>

            <div class="group rounded-3xl bg-surface p-8 text-center shadow-card ring-1 ring-border/50 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl">
                <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl bg-primary/10 text-4xl transition-transform duration-300 group-hover:scale-110">
                    ⭐
                </div>
                <h3 class="mt-5 text-xl font-bold text-text">
                    Trusted Reviews
                </h3>

                <p class="mt-3 text-muted">
                    Real ratings from verified guests.
                </p>
            </div>

            <div class="group rounded-3xl bg-surface p-8 text-center shadow-card ring-1 ring-border/50 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl">
                <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl bg-primary/10 text-4xl transition-transform duration-300 group-hover:scale-110">
                    📍
                </div>
                <h3 class="mt-5 text-xl font-bold text-text">
                    Great Locations
                </h3>

                <p class="mt-3 text-muted">
                    Stay close to popular attractions and city centers.
                </p>
            </div>
        </div>
    </section>

    <section class="mx-auto mt-28 mb-20 max-w-6xl px-6">
        <div class="relative overflow-hidden rounded-3xl bg-gradient-to-r from-primary via-secondary to-accent px-10 py-16 text-center text-white shadow-2xl">

            <div class="pointer-events-none absolute -top-16 -left-16 h-64 w-64 rounded-full bg-white/10 blur-3xl"></div>
            <div class="pointer-events-none absolute -bottom-20 -right-10 h-72 w-72 rounded-full bg-white/10 blur-3xl"></div>

            <div class="relative">
                <h2 class="text-4xl font-extrabold">
                    Ready for your next adventure?
                </h2>

                <p class="mx-auto mt-5 max-w-2xl text-lg text-slate-100">
                    Browse hundreds of beautiful homes and book your perfect stay in
                    just a few clicks.
                </p>

                <div class="mt-10 flex flex-wrap justify-center gap-5">
                    <a
                        href="<%= isLoggedIn ? '/homes' : '/login' %>"
                        class="rounded-xl bg-white px-8 py-4 font-semibold text-primary transition-all duration-300 hover:-translate-y-1 hover:shadow-xl">
                        Explore Homes
                    </a>

                    <% if (!isLoggedIn) { %>
                    <a
                        href="/signup"
                        class="rounded-xl border border-white px-8 py-4 font-semibold text-white transition-all duration-300 hover:bg-white hover:text-primary">
                        Join Now
                    </a>
                    <% } %>
                </div>
            </div>
        </div>
    </section>

</main>
<%- include("../partials/footer") %>
</body>

</html>
