<%- include('../partials/head') %>

<body class="bg-background">
<%- include('../partials/nav') %>
<main class="mx-auto max-w-7xl px-4 py-14">
    <section class="mb-5 text-center">
        <h1 class="text-4xl font-bold text-text">
            My Favourite Homes
        </h1>
        <p class="mt-3 text-lg text-muted">
            Browse and manage all the homes you've saved.
        </p>
    </section>

    <% if (favouriteHomes.length === 0) { %>
    <section class="flex justify-center mt-10">
        <div class="w-full max-w-sm rounded-2xl bg-white p-8 text-center shadow-card">
            <h2 class="text-2xl font-bold text-text">
                No Favourite Homes
            </h2>
            <p class="mt-4 mb-8 text-muted leading-7">
                Save the homes you love and they will appear here for quick access.
            </p>
            <a
                href="/homes"
                class="inline-flex items-center justify-center rounded-xl bg-primary px-6 py-3 font-semibold text-white transition duration-300 hover:bg-secondary hover:shadow-lg">
                Explore Homes
            </a>
        </div>
    </section>

    <% } else { %>
    <section class="flex flex-wrap justify-center gap-8">
        <% favouriteHomes.forEach(home => { %>
        <article
            class="group w-full max-w-sm overflow-hidden rounded-3xl bg-white shadow-card transition duration-300 hover:-translate-y-2 hover:shadow-xl">
            <div class="relative overflow-hidden">
                <img
                    src="<%= home.photo %>"
                    alt="<%= home.houseName %>"
                    class="h-64 w-full object-cover transition duration-500 group-hover:scale-110">

                    <div class="absolute left-4 top-4 rounded-full bg-yellow-100 px-3 py-1 text-sm font-semibold text-yellow-800">
                    ⭐ <%= home.rating %>
                </div>
            </div>
            <div class="space-y-5 p-6">
                <div>
                    <h2 class="text-2xl font-bold text-text">
                        <%= home.houseName %>
                    </h2>

                    <div class="mt-2 flex items-center gap-2 text-muted">
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="h-5 w-5 text-primary"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor">

                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M17.657 16.657L13.414 20.9a2 2 0 01-2.828 0L6.343 16.657a8 8 0 1111.314 0z" />

                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                    <span>
                        <%= home.location %>
                    </span>
                </div>
                </div>

                <div class="flex items-center justify-between">
                    <div>
                        <span class="text-3xl font-bold text-primary">
                            ₹<%= home.price %>
                        </span>

                        <span class="text-muted">
                            / night
                        </span>
                    </div>
                </div>

                <div class="flex gap-3">
                    <a
                        href="/homes/<%= home._id %>"
                        class="flex-1 rounded-xl bg-primary py-3 text-center font-semibold text-white transition duration-300 hover:bg-secondary">
                        View Details
                    </a>

                    <form
                        action="/favourites/delete/<%= home._id %>"
                        method="POST"
                        class="flex-1">

                        <button
                            type="submit"
                            onclick="return confirm('Remove this home from favourites?')"
                            class="w-full rounded-xl border border-red-500 bg-white py-3 font-semibold text-red-500 transition-all duration-300 hover:bg-red-500 hover:text-white">
                            Remove
                        </button>

                    </form>
                </div>
            </div>
        </article>

        <% }) %>
    </section>
    <% } %>

</main>
<%- include("../partials/footer") %>
</body>

</html>