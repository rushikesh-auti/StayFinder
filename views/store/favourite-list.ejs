<%- include('../partials/head') %>

<body class="bg-background">
<%- include('../partials/nav') %>
<main class="flex-1 mx-auto max-w-7xl px-4 py-14">
    <section class="mb-5 text-center">
        <h1 class="text-4xl font-bold text-text">
            My Favourite Homes
        </h1>
        <p class="mt-3 text-lg text-muted">
            Browse and manage all the homes you've saved.
        </p>
    </section>

    <% if (favouriteHomes.length === 0) { %>
    <section class="flex justify-center mt-10">
        <div class="w-full max-w-sm rounded-2xl bg-white p-8 text-center shadow-card">
            <h2 class="text-2xl font-bold text-text">
                No Favourite Homes
            </h2>
            <p class="mt-4 mb-8 text-muted leading-7">
                Save the homes you love and they will appear here for quick access.
            </p>
            <a
                href="/homes"
                class="inline-flex items-center justify-center rounded-xl bg-primary px-6 py-3 font-semibold text-white transition duration-300 hover:bg-secondary hover:shadow-lg">
                Explore Homes
            </a>
        </div>
    </section>

    <% } else { %>
    <section class="flex flex-wrap justify-center gap-8">
        <% favouriteHomes.forEach(home => { %>
        <article
            class="group flex h-full w-full max-w-sm flex-col overflow-hidden rounded-2xl bg-surface shadow-card ring-1 ring-border/60 transition duration-300 hover:-translate-y-1 hover:shadow-xl">
            <div class="relative aspect-[4/3] overflow-hidden bg-slate-100">
                <img
                    src="<%= home.photo %>"
                    alt="<%= home.houseName %>"
                    loading="lazy"
                    class="h-full w-full object-cover transition duration-700 ease-out group-hover:scale-105">
                <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-slate-950/45 via-transparent to-slate-950/10"></div>

                <div class="absolute left-4 top-4 flex items-center gap-1 rounded-full border border-white/50 bg-white/20 px-3 py-1.5 text-sm font-bold text-white shadow-lg backdrop-blur-md">
                    <span class="text-amber-300" aria-hidden="true">★</span>
                    <span><%= home.averageRating || home.rating %></span>
                    <% if (home.reviewCount) { %>
                        <span class="font-medium text-white/80">(<%= home.reviewCount %>)</span>
                    <% } %>
                </div>

                <div class="absolute right-4 top-4">
                    <%- include('../partials/favourite', { home, user, isFavourite: true }) %>
                </div>
            </div>
            <div class="flex flex-1 flex-col p-5 sm:p-6">
                <div>
                    <h2 class="truncate text-xl font-bold tracking-tight text-text">
                        <%= home.houseName %>
                    </h2>

                    <div class="mt-2 flex items-center gap-2 text-sm text-muted">
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="h-4 w-4 shrink-0 text-primary"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor">

                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M17.657 16.657L13.414 20.9a2 2 0 01-2.828 0L6.343 16.657a8 8 0 1111.314 0z" />

                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                    <span class="truncate">
                        <%= home.location %>
                    </span>
                </div>
                </div>

                <div class="mt-auto flex items-end justify-between pt-6">
                    <div>
                        <span class="text-2xl font-extrabold tracking-tight text-text">
                            ₹<%= home.price %>
                        </span>

                        <span class="text-xs font-medium text-muted">/ night</span>
                    </div>
                </div>

                <div class="mt-5 flex gap-3">
                    <a
                        href="/homes/<%= home._id %>"
                        class="flex-1 rounded-xl bg-primary py-3 text-center text-sm font-bold text-white transition duration-300 hover:bg-secondary">
                        View stay
                    </a>

                    <form
                        action="/favourites/delete/<%= home._id %>"
                        method="POST"
                        class="flex-1">

                        <button
                            type="submit"
                            onclick="return confirm('Remove this home from favourites?')"
                            class="w-full rounded-xl border border-red-200 bg-transparent py-3 text-sm font-bold text-red-500 transition-all duration-300 hover:border-red-500 hover:bg-red-500 hover:text-white">
                            Remove
                        </button>

                    </form>
                </div>
            </div>
        </article>

        <% }) %>
    </section>
    <% } %>

</main>
<%- include("../partials/footer") %>
</body>

</html>