<%- include('../partials/head') %>

  <body class="bg-background">
    <%- include('../partials/nav') %>
      <main class="flex-1 mx-auto max-w-7xl px-4 py-14">
        <section class="text-center mt-2 mb-5">
          <h1 class="text-4xl font-bold text-text">
            Manage Properties
          </h1>
          <p class="mt-3 text-lg text-muted">
            View, edit and organize all of your listed homes.
          </p>
        </section>

        <% if (registeredHomes.length===0) { %>
          <section class="flex justify-center mt-16">

            <div class="w-full max-w-md rounded-2xl bg-surface shadow-card p-8 text-center">
              <div class="mx-auto mb-5 flex h-16 w-16 items-center justify-center rounded-full bg-primary/10">

                <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-primary" fill="none" viewBox="0 0 24 24"
                  stroke="currentColor">

                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M3 10.5L12 3l9 7.5M5 9v10a1 1 0 001 1h4v-6h4v6h4a1 1 0 001-1V9" />

                </svg>

              </div>

              <h2 class="text-2xl font-bold text-text">
                No Properties Yet
              </h2>

              <p class="mt-2 mb-5 text-muted">
                Add your first property and start hosting guests.
              </p>

              <a href="/host/add-home"
                class="mt-6 inline-flex items-center justify-center rounded-xl bg-primary px-6 py-3 font-semibold text-white transition hover:bg-secondary">
                 Add Property
              </a>
            </div>
          </section>

          <% } else { %>
            <section class="grid gap-6 sm:grid-cols-2 xl:grid-cols-3">
              <% registeredHomes.forEach(home=> { %>
                <article
                  class="group flex h-full flex-col overflow-hidden rounded-2xl bg-surface shadow-card ring-1 ring-border/60 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl">

                  <div class="relative aspect-[4/3] overflow-hidden bg-slate-100">
                    <img src="<%= home.photo || 'data:image/svg+xml,%3Csvg xmlns=\'http://www.w3.org/2000/svg\' viewBox=\'0 0 800 600\'%3E%3Crect width=\'800\' height=\'600\' fill=\'%23e2e8f0\'/%3E%3Cpath d=\'M180 430l135-145 95 95 70-70 140 120H180z\' fill=\'%2394a3b8\'/%3E%3Ccircle cx=\'555\' cy=\'205\' r=\'52\' fill=\'%2394a3b8\'/%3E%3C/svg%3E' %>" alt="<%= home.houseName %> property photo"
                      loading="lazy"
                      onerror="this.onerror=null;this.src='data:image/svg+xml,%3Csvg xmlns=\'http://www.w3.org/2000/svg\' viewBox=\'0 0 800 600\'%3E%3Crect width=\'800\' height=\'600\' fill=\'%23e2e8f0\'/%3E%3Cpath d=\'M180 430l135-145 95 95 70-70 140 120H180z\' fill=\'%2394a3b8\'/%3E%3Ccircle cx=\'555\' cy=\'205\' r=\'52\' fill=\'%2394a3b8\'/%3E%3C/svg%3E'"
                      class="h-full w-full object-cover transition duration-700 ease-out group-hover:scale-105">

                    <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-slate-950/45 via-transparent to-slate-950/10"></div>

                    <div
                      class="absolute left-4 top-4 flex items-center gap-1 rounded-full border border-white/50 bg-white/20 px-3 py-1.5 text-sm font-bold text-white shadow-lg backdrop-blur-md">
                      <span class="text-amber-300">★</span>
                      <span><%= home.averageRating || home.rating %></span>
                      <% if (home.reviewCount) { %>
                        <span class="font-medium text-white/80">(<%= home.reviewCount %>)</span>
                      <% } %>
                    </div>
                  </div>

                  <div class="flex flex-1 flex-col p-5 sm:p-6">
                    <h2 class="truncate text-xl font-bold tracking-tight text-text">
                      <%= home.houseName %>
                    </h2>

                    <p class="mt-2 flex items-center gap-2 text-sm text-muted">

                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-4 w-4 shrink-0 text-primary"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor">

                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M17.657 16.657L13.414 20.9a2 2 0 01-2.828 0l-4.243-4.243a8 8 0 1111.314 0z"/>

                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>

                <span class="truncate"><%= home.location %></span>

            </p>
                    <% if (home.description) { %>
                      <p class="mt-3 line-clamp-2 text-sm leading-6 text-muted"><%= home.description %></p>
                    <% } %>
                    <div class="mt-auto flex items-end justify-between pt-6">
                      <div>
                        <p class="text-2xl font-extrabold tracking-tight text-text">
                          ₹<%= home.price %>
                        </p>

                        <p class="text-xs font-medium text-muted">per night</p>
                      </div>
                      <% if (home.createdAt) { %>
                        <span class="text-right text-xs font-medium text-muted">Added <%= new Date(home.createdAt).toLocaleDateString("en-IN", { day: "numeric", month: "short", year: "numeric" }) %></span>
                      <% } %>
                    </div>

                    <div class="mt-5 grid grid-cols-3 gap-2">
                      <a href="/homes/<%= home._id %>"
                        class="rounded-xl border border-border py-3 text-center text-sm font-bold text-text transition duration-300 hover:border-primary hover:bg-primary/5 hover:text-primary focus:outline-none focus:ring-2 focus:ring-primary/30">
                        View
                      </a>
                      <a href="/host/edit-home/<%= home._id %>?editing=true"
                        class="rounded-xl bg-primary py-3 text-center text-sm font-bold text-white transition duration-300 hover:bg-secondary hover:shadow-lg focus:outline-none focus:ring-2 focus:ring-primary/30">
                        Edit
                      </a>

                      <form action="/host/delete-home/<%= home._id %>" method="POST">

                        <button type="submit" onclick="return confirm('Delete this property?')"
                          class="w-full rounded-xl border border-red-200 py-3 text-sm font-bold text-red-500 transition duration-300 hover:border-red-500 hover:bg-red-500 hover:text-white focus:outline-none focus:ring-2 focus:ring-red-300">
                          Delete
                        </button>
                      </form>

                    </div>
                  </div>
                </article>
                <% }) %>
            </section>
            <% } %>

      </main>
      <%- include("../partials/footer") %>
  </body>

  </html>