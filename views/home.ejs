<%- include ('partials/head') %>
  </head>

  <body class="bg-gray-100">
    <%- include ('partials/nav') %>
      <main class="flex flex-col items-center justify-center mt-20">
        <h1 class="text-red-700 text-5xl font-bold mb-4">
          Here Are Our Registered Homes:
        </h1>
        <ul>
          <% registeredHomes.forEach(home=> { %>
            <li class="mb-2 text-lg text-gray-700">
              <%= home.homeName %> - <%= home.location %>
            </li>
            <% }) %>
        </ul>
      </main>
  </body>

  </html>