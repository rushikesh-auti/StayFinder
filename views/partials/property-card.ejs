<%
  const isFavourite = (favouriteIds || []).includes(home._id.toString());
  const displayRating = home.averageRating || home.rating;
  const reviewCount = home.reviewCount || 0;
  const imageFallback = "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 800 600'%3E%3Crect width='800' height='600' fill='%23e2e8f0'/%3E%3Cpath d='M180 430l135-145 95 95 70-70 140 120H180z' fill='%2394a3b8'/%3E%3Ccircle cx='555' cy='205' r='52' fill='%2394a3b8'/%3E%3C/svg%3E";
%>

<article class="group flex h-full flex-col overflow-hidden rounded-2xl bg-surface shadow-card ring-1 ring-border/60 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl">
  <div class="relative aspect-[4/3] overflow-hidden bg-slate-100">
    <img
      src="<%= home.photo || imageFallback %>"
      alt="<%= home.houseName %> property photo"
      loading="lazy"
      onerror="this.onerror=null;this.src='<%= imageFallback %>'"
      class="h-full w-full object-cover transition duration-500 ease-out group-hover:scale-105">
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-slate-950/50 via-transparent to-slate-950/10"></div>

    <div class="absolute left-4 top-4 flex items-center gap-1 rounded-full border border-white/50 bg-white/20 px-3 py-1.5 text-sm font-bold text-white shadow-lg backdrop-blur-md">
      <span class="text-amber-300" aria-hidden="true">★</span>
      <span><%= displayRating %></span>
      <% if (reviewCount > 0) { %>
        <span class="font-medium text-white/80">(<%= reviewCount %>)</span>
      <% } %>
    </div>

    <div class="absolute right-4 top-4">
      <%- include('./favourite', { home, user, isFavourite }) %>
    </div>
  </div>

  <div class="flex flex-1 flex-col p-5 sm:p-6">
    <div class="min-w-0">
      <p class="truncate text-sm font-medium text-primary"><%= home.location %></p>
      <h2 class="mt-1 truncate text-xl font-bold tracking-tight text-text"><%= home.houseName %></h2>
    </div>

    <% if (home.description) { %>
      <p class="mt-3 line-clamp-2 text-sm leading-6 text-muted"><%= home.description %></p>
    <% } %>

    <div class="mt-auto flex items-end justify-between gap-4 pt-6">
      <div>
        <span class="text-2xl font-extrabold tracking-tight text-text">₹<%= home.price %></span>
        <span class="text-xs font-medium text-muted"> / night</span>
      </div>
      <a
        href="<%= isLoggedIn ? '/homes/' + home._id : '/login' %>"
        class="inline-flex items-center gap-2 rounded-xl bg-primary px-4 py-2.5 text-sm font-bold text-white transition-all duration-300 hover:bg-secondary hover:shadow-lg focus:outline-none focus:ring-2 focus:ring-primary/40 active:scale-[0.98]">
        View details <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</article>
