<div class="page-wrapper flex min-h-screen flex-col">
  <header
    class="sticky top-0 z-50 border-b border-border/80 bg-surface/95 shadow-navbar backdrop-blur"
  >
    <nav
      class="container mx-auto flex min-h-[64px] items-center gap-2 px-4 sm:px-6"
    >
      <a
        href="/"
        class="shrink-0 rounded-xl px-1 py-2 text-2xl font-extrabold tracking-tight text-text transition hover:text-primary"
        aria-label="StayFinder home">
        StayFinder
      </a>

      <div class="hidden flex-1 items-center justify-center gap-2 lg:flex">
        <form
          action="/homes/search"
          method="GET"
          class="flex w-full max-w-sm items-center rounded-full border border-border bg-white px-3 py-1.5 shadow-sm transition focus-within:border-primary focus-within:ring-4 focus-within:ring-primary/10"
        >
          <svg
            class="h-5 w-5 shrink-0 text-muted"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="m21 21-4.35-4.35m1.85-5.15a7 7 0 1 1-14 0 7 7 0 0 1 14 0Z"
            />
          </svg>
          <input
            type="text"
            name="q"
            value="<%= typeof query !== 'undefined' ? query : '' %>"
            placeholder="Search properties"
            class="min-w-0 flex-1 border-0 bg-transparent px-2 outline-none placeholder:text-muted"
          />
          <button
            type="submit"
            class="rounded-full bg-primary p-2 text-white transition hover:bg-secondary focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2"
            aria-label="Search properties"
          >
            <svg
              class="h-4 w-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="m21 21-4.35-4.35m1.85-5.15a7 7 0 1 1-14 0 7 7 0 0 1 14 0Z"
              />
            </svg>
          </button>
        </form>

        <% if (isLoggedIn && user.userType === 'guest') { %>
        <a
          href="/homes"
          class="<%= currentPage === 'Home' ? 'bg-primary text-white shadow-sm' : 'text-text hover:bg-primary/10 hover:text-primary' %> rounded-lg px-3 py-2 font-semibold transition"
          >Explore</a
        >
        <a
          href="/favourites"
          class="<%= currentPage === 'favourites' ? 'bg-primary text-white shadow-sm' : 'text-text hover:bg-primary/10 hover:text-primary' %> rounded-lg px-3 py-2 font-semibold transition"
          >Favourites</a
        >
        <a
          href="/bookings"
          class="<%= currentPage === 'bookings' ? 'bg-primary text-white shadow-sm' : 'text-text hover:bg-primary/10 hover:text-primary' %> rounded-lg px-3 py-2 font-semibold transition"
          >My Bookings</a
        >
        <% } else if (isLoggedIn) { %>
        <a
          href="/host/host-home-list"
          class="<%= currentPage === 'host-homes' ? 'bg-primary text-white shadow-sm' : 'text-text hover:bg-primary/10 hover:text-primary' %> rounded-lg px-3 py-2 font-semibold transition"
          >My Properties</a
        >
        <a
          href="/host/add-home"
          class="<%= currentPage === 'addHome' ? 'bg-primary text-white shadow-sm' : 'text-text hover:bg-primary/10 hover:text-primary' %> rounded-lg px-3 py-2 font-semibold transition"
          >Add Property</a
        >
        <a
          href="/host/host-bookings"
          class="<%= currentPage === 'host-bookings' ? 'bg-primary text-white shadow-sm' : 'text-text hover:bg-primary/10 hover:text-primary' %> rounded-lg px-3 py-2 font-semibold transition"
          >Manage Bookings</a
        >
        <% } %>
      </div>

      <div class="ml-auto hidden items-center gap-2 lg:flex">
        <button
          type="button"
          class="theme-toggle-btn inline-flex h-10 w-10 items-center justify-center rounded-lg border border-border bg-white text-text shadow-sm transition hover:border-primary hover:text-primary focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2"
          aria-label="Toggle theme"
          title="Toggle theme"
        >
          <svg
            data-theme-icon="light"
            class="h-5 w-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M12 3v2m0 14v2m9-9h-2M5 12H3m15.364-6.364l-1.414 1.414M7.05 16.95l-1.414 1.414M18.364 18.364l-1.414-1.414M7.05 7.05L5.636 5.636"
            />
          </svg>
          <svg
            data-theme-icon="dark"
            class="hidden h-5 w-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"
            />
          </svg>
        </button>
        <% if (!isLoggedIn) { %>
          <a
            href="/signup"
            class="rounded-lg border border-primary bg-white px-4 py-2 text-sm font-semibold text-primary transition-all duration-300 hover:bg-primary hover:text-white"
          >Sign up</a>
          <a
            href="/login"
            class="rounded-lg border border-primary bg-white px-4 py-2 text-sm font-semibold text-primary transition-all duration-300 hover:bg-primary hover:text-white focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2"
          >Log in</a>
        <% } else { %>
        <form action="/logout" method="POST">
          <button
            class="rounded-xl border border-primary px-4 py-2 text-sm font-semibold text-primary transition-all duration-300 hover:bg-primary hover:text-white"
          >
            Log out
          </button>
        </form>
        <% } %>
      </div>

      <button
        id="mobile-menu-button"
        type="button"
        class="ml-auto inline-flex h-10 w-10 items-center justify-center rounded-lg border border-border bg-white text-text shadow-sm transition hover:border-primary hover:text-primary focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 lg:hidden"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label="Open navigation menu"
      >
        <svg
          id="icon-open"
          class="h-5 w-5"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M4 6h16M4 12h16M4 18h16"
          />
        </svg>
        <svg
          id="icon-close"
          class="hidden h-5 w-5"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="m6 18 12-12M6 6l12 12"
          />
        </svg>
      </button>
    </nav>

    <div
      id="mobile-menu"
      class="hidden border-t border-border bg-surface px-4 pb-5 pt-4 shadow-navbar lg:hidden"
    >
      <div class="container mx-auto">
        <form
          action="/homes/search"
          method="GET"
          class="mb-4 flex items-center rounded-xl border border-border bg-white px-3 py-2 shadow-sm focus-within:border-primary focus-within:ring-4 focus-within:ring-primary/10"
        >
          <svg
            class="h-5 w-5 shrink-0 text-muted"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="m21 21-4.35-4.35m1.85-5.15a7 7 0 1 1-14 0 7 7 0 0 1 14 0Z"
            />
          </svg>
          <input
            type="text"
            name="q"
            value="<%= typeof query !== 'undefined' ? query : '' %>"
            placeholder="Where do you want to stay?"
            class="min-w-0 flex-1 border-0 bg-transparent px-2 py-1 outline-none placeholder:text-muted"
          />
          <button
            type="submit"
            class="rounded-lg bg-primary p-2.5 text-white transition hover:bg-secondary"
            aria-label="Search properties"
          >
            <svg
              class="h-5 w-5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="m21 21-4.35-4.35M10.5 18a7.5 7.5 0 1 1 0-15 7.5 7.5 0 0 1 0 15Z"
              />
            </svg>
          </button>
        </form>

        <div class="mb-4 flex items-center justify-end gap-2">
          <button
            type="button"
            class="theme-toggle-btn inline-flex h-10 w-10 items-center justify-center rounded-lg border border-border bg-white text-text shadow-sm transition hover:border-primary hover:text-primary focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2"
            aria-label="Toggle theme"
            title="Toggle theme"
          >
            <svg
              data-theme-icon="light"
              class="h-5 w-5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M12 3v2m0 14v2m9-9h-2M5 12H3m15.364-6.364l-1.414 1.414M7.05 16.95l-1.414 1.414M18.364 18.364l-1.414-1.414M7.05 7.05L5.636 5.636"
              />
            </svg>
            <svg
              data-theme-icon="dark"
              class="hidden h-5 w-5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"
              />
            </svg>
          </button>
        </div>

        <div class="grid gap-1">
          <% if (isLoggedIn && user.userType === 'guest') { %>
          <a
            href="/homes"
            class="<%= currentPage === 'Home' ? 'bg-primary text-white shadow-sm' : 'text-text hover:bg-primary/10 hover:text-primary' %> flex items-center justify-between rounded-xl px-4 py-2.5 font-semibold transition"
            >Explore <span aria-hidden="true">→</span></a
          >
          <a
            href="/favourites"
            class="<%= currentPage === 'favourites' ? 'bg-primary text-white shadow-sm' : 'text-text hover:bg-primary/10 hover:text-primary' %> flex items-center justify-between rounded-xl px-4 py-2.5 font-semibold transition"
            >Favourites <span aria-hidden="true">→</span></a
          >
          <a
            href="/bookings"
            class="<%= currentPage === 'bookings' ? 'bg-primary text-white shadow-sm' : 'text-text hover:bg-primary/10 hover:text-primary' %> flex items-center justify-between rounded-xl px-4 py-2.5 font-semibold transition"
            >My Bookings <span aria-hidden="true">→</span></a
          >
          <% } else if (isLoggedIn) { %>
          <a
            href="/host/host-home-list"
            class="<%= currentPage === 'host-homes' ? 'bg-primary text-white shadow-sm' : 'text-text hover:bg-primary/10 hover:text-primary' %> flex items-center justify-between rounded-xl px-4 py-2.5 font-semibold transition"
            >My Properties <span aria-hidden="true">→</span></a
          >
          <a
            href="/host/add-home"
            class="<%= currentPage === 'addHome' ? 'bg-primary text-white shadow-sm' : 'text-text hover:bg-primary/10 hover:text-primary' %> flex items-center justify-between rounded-xl px-4 py-2.5 font-semibold transition"
            >Add Property <span aria-hidden="true">→</span></a
          >
          <a
            href="/host/host-bookings"
            class="<%= currentPage === 'host-bookings' ? 'bg-primary text-white shadow-sm' : 'text-text hover:bg-primary/10 hover:text-primary' %> flex items-center justify-between rounded-xl px-4 py-2.5 font-semibold transition"
            >Manage Bookings <span aria-hidden="true">→</span></a
          >
          <% } %>
        </div>

        <div class="mt-4 border-t border-border pt-4">
          <% if (!isLoggedIn) { %>
          <div class="grid grid-cols-2 gap-3">
            <a
              href="/signup"
              class="rounded-xl border border-primary bg-white px-4 py-2.5 text-center font-semibold text-primary transition-all duration-300 hover:bg-primary hover:text-white"
              >Sign up</a
            >
            <a
              href="/login"
              class="rounded-xl border border-primary bg-white px-4 py-2.5 text-center font-semibold text-primary transition-all duration-300 hover:bg-primary hover:text-white"
              >Log in</a
            >
          </div>
          <% } else { %>
          <form action="/logout" method="POST">
            <button
              class="w-full rounded-xl border border-primary bg-white px-4 py-2.5 font-semibold text-primary transition-all duration-300 hover:bg-primary hover:text-white"
            >
              Log out
            </button>
          </form>
          <% } %>
        </div>
      </div>
    </div>
  </header>

  <script>
    (function () {
      const navButton = document.getElementById("mobile-menu-button");
      const menu = document.getElementById("mobile-menu");
      const openIcon = document.getElementById("icon-open");
      const closeIcon = document.getElementById("icon-close");
      const root = document.documentElement;
      const themeButtons = Array.from(document.querySelectorAll('.theme-toggle-btn'));

      function updateThemeButtons(isDark) {
        themeButtons.forEach((btn) => {
          const lightIcon = btn.querySelector('[data-theme-icon="light"]');
          const darkIcon = btn.querySelector('[data-theme-icon="dark"]');
          if (lightIcon) lightIcon.classList.toggle('hidden', isDark);
          if (darkIcon) darkIcon.classList.toggle('hidden', !isDark);
          btn.setAttribute('aria-label', isDark ? 'Switch to light mode' : 'Switch to dark mode');
        });
      }

      function setTheme(theme) {
        const isDark = theme === 'dark';
        root.classList.toggle('dark', isDark);
        localStorage.setItem('theme', theme);
        updateThemeButtons(isDark);
      }

      if (themeButtons.length) {
        themeButtons.forEach((btn) => {
          btn.addEventListener('click', function () {
            setTheme(root.classList.contains('dark') ? 'light' : 'dark');
          });
        });
        updateThemeButtons(root.classList.contains('dark'));
      }

      if (!navButton || !menu) return;

      navButton.addEventListener("click", function () {
        const isOpen = !menu.classList.contains("hidden");
        menu.classList.toggle("hidden", isOpen);
        openIcon.classList.toggle("hidden", !isOpen);
        closeIcon.classList.toggle("hidden", isOpen);
        navButton.setAttribute("aria-expanded", String(!isOpen));
        navButton.setAttribute(
          "aria-label",
          isOpen ? "Open navigation menu" : "Close navigation menu",
        );
      });
    })();
  </script>
