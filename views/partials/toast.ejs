<% if (successMessage && successMessage.length) { %>
  <div
    id="toast-success"
    class="fixed right-4 top-4 z-[9999] w-full max-w-sm rounded-2xl bg-green-500 px-5 py-4 text-white shadow-2xl sm:right-5 sm:top-5"
  >
    <div class="flex items-start gap-3">
      <div class="mt-0.5 text-xl">✅</div>
      <div class="flex-1">
        <p class="font-semibold">Success</p>
        <p class="text-sm text-white/90"><%= successMessage[0] %></p>
      </div>
      <button
        type="button"
        onclick="document.getElementById('toast-success').remove()"
        class="text-white/80 hover:text-white"
      >
        ✕
      </button>
    </div>
  </div>
<% } %>

<% if (errorMessage && errorMessage.length) { %>
  <div
    id="toast-error"
    class="fixed right-4 top-4 z-[9999] w-full max-w-sm rounded-2xl bg-red-500 px-5 py-4 text-white shadow-2xl sm:right-5 sm:top-5"
  >
    <div class="flex items-start gap-3">
      <div class="mt-0.5 text-xl">⚠️</div>
      <div class="flex-1">
        <p class="font-semibold">Error</p>
        <p class="text-sm text-white/90"><%= errorMessage[0] %></p>
      </div>
      <button
        type="button"
        onclick="document.getElementById('toast-error').remove()"
        class="text-white/80 hover:text-white"
      >
        ✕
      </button>
    </div>
  </div>
<% } %>

<script>
  setTimeout(() => {
    document.getElementById("toast-success")?.remove();
    document.getElementById("toast-error")?.remove();
  }, 3500);
</script>