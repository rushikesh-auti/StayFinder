<%
  const getMessageList = (value) => {
    if (!value) return [];
    if (Array.isArray(value)) return value.filter(Boolean);
    return [value];
  };

  const { success, error } = flashMessages();
  const successItems = getMessageList(success);
  const errorItems = getMessageList(error);
%>

<div
  id="toast-container"
  class="pointer-events-none fixed left-1/2 top-24 z-[9999] flex w-full max-w-sm -translate-x-1/2 flex-col items-center gap-2 px-4"
>
  <% successItems.forEach((message) => { %>
    <div
      data-toast
      class="toast-enter pointer-events-auto flex w-full items-center gap-3 rounded-xl border border-slate-200 bg-white px-4 py-3 shadow-lg shadow-slate-900/10"
    >
      <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-emerald-600">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
        </svg>
      </span>

      <p class="min-w-0 flex-1 text-sm font-medium text-slate-700"><%= message %></p>

      <button
        type="button"
        onclick="dismissToast(this.closest('[data-toast]'))"
        class="shrink-0 rounded-md p-1 text-slate-300 transition hover:bg-slate-50 hover:text-slate-500"
        aria-label="Close notification"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
  <% }) %>

  <% errorItems.forEach((message) => { %>
    <div
      data-toast
      class="toast-enter pointer-events-auto flex w-full items-center gap-3 rounded-xl border border-slate-200 bg-white px-4 py-3 shadow-lg shadow-slate-900/10"
    >
      <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-rose-100 text-rose-600">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </span>

      <p class="min-w-0 flex-1 text-sm font-medium text-slate-700"><%= message %></p>

      <button
        type="button"
        onclick="dismissToast(this.closest('[data-toast]'))"
        class="shrink-0 rounded-md p-1 text-slate-300 transition hover:bg-slate-50 hover:text-slate-500"
        aria-label="Close notification"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
  <% }) %>
</div>

<style>
  .toast-enter {
    animation: toast-in 0.25s ease-out;
  }

  .toast-exit {
    animation: toast-out 0.2s ease-in forwards;
  }

  @keyframes toast-in {
    from { opacity: 0; transform: translateY(-10px) scale(0.96); }
    to   { opacity: 1; transform: translateY(0) scale(1); }
  }

  @keyframes toast-out {
    from { opacity: 1; transform: translateY(0) scale(1); }
    to   { opacity: 0; transform: translateY(-10px) scale(0.96); }
  }
</style>

<script>
  function dismissToast(el) {
    if (!el) return;
    el.classList.remove('toast-enter');
    el.classList.add('toast-exit');
    setTimeout(() => el.remove(), 200);
  }

  document.querySelectorAll('[data-toast]').forEach((toast) => {
    setTimeout(() => dismissToast(toast), 3000);
  });
</script>