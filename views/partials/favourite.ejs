<% const isOwner = user && home && home.host && home.host.toString() === user._id.toString(); %>

<% if (!user) { %>
<a
  href="/login"
  class="inline-flex items-center justify-center rounded-xl bg-primary px-5 py-3 font-semibold text-white transition-all duration-300 hover:bg-secondary hover:shadow-lg">
   Add to Favourite
</a>
<% } else if (!isOwner) { %>
<form action="/favourites" method="POST" class="inline-block">
  <input type="hidden" name="id" value="<%= home._id %>">

  <button
    type="submit"
    class="inline-flex items-center justify-center rounded-xl bg-primary px-5 py-3 font-semibold text-white transition-all duration-300 hover:bg-secondary hover:shadow-lg">
     Add to Favourite
  </button>
</form>
<% } %>