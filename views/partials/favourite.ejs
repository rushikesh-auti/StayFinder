<% const isOwner = user && home && home.host && home.host.toString() === user._id.toString(); %>
<% const saved = typeof isFavourite === "boolean" ? isFavourite : false; %>

<% if (!user) { %>

<a href="/login" aria-label="Sign in to save this property" title="Sign in to save this property" class="group/favourite flex h-11 w-11 items-center justify-center rounded-full border border-white/60 bg-white/20 text-white shadow-lg backdrop-blur-md transition-all duration-300 hover:scale-105 hover:bg-white/90 hover:text-red-500">

    <svg
      xmlns="http://www.w3.org/2000/svg"
      class="h-5 w-5 transition-transform duration-300 group-hover/favourite:scale-110"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
      stroke-width="2">

      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M4.318 6.318a4.5 4.5 0 000 6.364L12
        20.364l7.682-7.682a4.5 4.5 0
        00-6.364-6.364L12 7.636l-1.318-1.318a4.5
        4.5 0 00-6.364 0z"/>

    </svg>

</a>

<% } else if (!isOwner) { %>

<form action="<%= saved ? '/favourites/delete/' + home._id : '/favourites' %>" method="POST" class="flex">

  <input type="hidden" name="id" value="<%= home._id %>">

  <button
    type="submit"
    aria-label="<%= saved ? 'Remove this property from favourites' : 'Save this property to favourites' %>"
    title="<%= saved ? 'Remove from favourites' : 'Save to favourites' %>"
    class="group/favourite flex h-11 w-11 items-center justify-center rounded-full border border-white/60 bg-white/20 <%= saved ? 'text-rose-200' : 'text-white' %> shadow-lg backdrop-blur-md transition-all duration-300 hover:scale-105 hover:bg-white/90 hover:text-red-500 focus:outline-none focus:ring-2 focus:ring-white">

    <svg
      xmlns="http://www.w3.org/2000/svg"
      class="h-5 w-5 transition-transform duration-300 group-hover/favourite:scale-110"
      fill="<%= saved ? 'currentColor' : 'none' %>"
      viewBox="0 0 24 24"
      stroke="currentColor"
      stroke-width="2">

      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M4.318 6.318a4.5 4.5 0 000 6.364L12
        20.364l7.682-7.682a4.5 4.5 0
        00-6.364-6.364L12 7.636l-1.318-1.318a4.5
        4.5 0 00-6.364 0z"/>

    </svg>

  </button>

</form>

<% } %>